<%- include('../partials/operator-page-start', {pageTitle:'Profil Model Binaan',pageKey:'managed-models'}) %>
<div class="max-w-4xl mx-auto space-y-6">
    <a href="/operator/models" class="text-admin-700 font-semibold">← Model Binaan</a>
    <div class="bg-white rounded-xl shadow p-6 space-y-6">
        <h2 class="text-2xl font-bold text-gray-800"><%= model.full_name %></h2>
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <% [['Grade',model.grade_name],['Status',model.status],['Telepon',model.phone],['Jenis Kelamin',model.gender],['Tinggi (cm)',model.height],['Berat (kg)',model.weight],['Ukuran',model.measurements],['Pengalaman',model.experience_level],['Rate Gaji Model/TRX',model.salary_rate != null ? formatCurrency(model.salary_rate) : 'Belum diisi'],['Fee Agen/TRX',formatCurrency(model.agent_fee_flat)]].forEach(([label,value])=>{ %>
            <div><dt class="text-sm text-gray-500"><%= label %></dt><dd class="font-semibold break-words"><%= value || '-' %></dd></div>
            <% }); %>
        </dl>
        <div><h3 class="font-semibold">Bio</h3><p class="text-gray-600 whitespace-pre-line"><%= model.bio || '-' %></p></div>
    </div>
    <% if (photos.length) { %><div class="grid grid-cols-1 md:grid-cols-3 gap-4"><% photos.forEach(photo=>{ %><figure class="bg-white rounded-xl shadow overflow-hidden"><img src="<%= photo.file_path %>" alt="<%= photo.caption || model.full_name %>" class="w-full h-64 object-cover" loading="lazy"><% if(photo.caption) { %><figcaption class="p-3 text-sm"><%= photo.caption %></figcaption><% } %></figure><% }); %></div><% } %>
</div>
<%- include('../partials/operator-page-end') %>
