<div id="clientPaymentsModal" class="hidden fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-2xl max-h-[90dvh] overflow-y-auto p-6">
        <div class="flex justify-between gap-4 mb-4"><div><h3 class="text-xl font-bold">Pembayaran Client</h3><p id="paymentClient" class="text-gray-500"></p></div><button type="button" onclick="closeClientPayments()" aria-label="Tutup pembayaran">✕</button></div>
        <div class="grid grid-cols-3 gap-3 bg-gray-50 rounded-lg p-3 mb-4 text-sm">
            <div>Tagihan<p id="paymentInvoice" class="font-bold"></p></div><div>Diterima<p id="paymentReceived" class="font-bold text-green-700"></p></div><div>Sisa<p id="paymentOutstanding" class="font-bold text-orange-700"></p></div>
        </div>
        <form id="clientPaymentForm" class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <label class="text-sm">Nominal diterima (Rp)<input id="paymentAmount" type="number" min="0.01" step="0.01" required class="w-full border rounded-lg p-2"></label>
            <label class="text-sm">Tanggal diterima<input id="paymentDate" type="date" required class="w-full border rounded-lg p-2"></label>
            <label class="text-sm">Metode<select id="paymentMethod" class="w-full border rounded-lg p-2"><option value="transfer">Transfer</option><option value="cash">Tunai</option><option value="other">Lainnya</option></select></label>
            <label class="text-sm">Referensi<input id="paymentReference" maxlength="150" class="w-full border rounded-lg p-2" placeholder="Nomor transfer / bukti bayar"></label>
            <label class="text-sm md:col-span-2">Catatan<textarea id="paymentNotes" maxlength="1000" rows="2" class="w-full border rounded-lg p-2"></textarea></label>
            <p class="text-xs text-gray-500 md:col-span-2">Catat hanya uang yang sudah diterima. Pembayaran boleh dicicil. Uang masuk mengikuti tanggal pembayaran.</p>
            <button id="saveClientPayment" type="submit" class="md:col-span-2 rounded-lg px-4 py-2 bg-green-600 text-white disabled:opacity-50">Simpan Pembayaran</button>
        </form>
        <h4 class="font-semibold mt-6 mb-3">Riwayat Pembayaran</h4><div id="paymentHistory" class="space-y-3"></div>
    </div>
</div>
