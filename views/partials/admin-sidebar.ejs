<aside id="sidebar" class="sidebar fixed md:relative inset-y-0 left-0 z-30 w-64 bg-admin-800 text-white transform -translate-x-full md:translate-x-0 transition-transform duration-300" aria-label="Navigasi admin">
    <div class="flex flex-col h-full">
        <div class="flex items-center justify-between h-16 shrink-0 px-6 bg-admin-900">
            <div class="flex items-center space-x-2"><i class="fas fa-star text-admin-400 text-xl"></i><span class="text-xl font-bold">Admin Panel</span></div>
            <button id="close-sidebar" type="button" class="md:hidden text-white" aria-label="Tutup menu"><i class="fas fa-times text-xl" aria-hidden="true"></i></button>
        </div>
        <nav class="flex-1 min-h-0 px-4 py-6 space-y-2 overflow-y-auto">
            <% const navigation = [
                ['dashboard', '/admin/dashboard', 'fa-tachometer-alt', 'Dashboard'],
                ['models', '/admin/models', 'fa-users', 'Models'],
                ['model-grades', '/admin/model-grades', 'fa-layer-group', 'Model Grades'],
                ['agents', '/admin/agents', 'fa-user-tie', 'Agents'],
                ['clients', '/admin/clients', 'fa-building', 'Clients'],
                ['jobs', '/admin/jobs', 'fa-briefcase', 'Jobs'],
                ['transactions', '/admin/transactions', 'fa-exchange-alt', 'Transactions'],
                ['analytics', '/admin/analytics', 'fa-chart-line', 'Analytics'],
                ['complaints', '/admin/complaints', 'fa-exclamation-triangle', 'Complaints'],
                ['users', '/admin/users', 'fa-user-cog', 'Users']
            ]; %>
            <% navigation.forEach(([key, href, icon, label]) => { %>
                <a href="<%= href %>" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-admin-700 transition <%= activePage === key ? 'bg-admin-700' : '' %>" <%- activePage === key ? 'aria-current="page"' : '' %>><i class="fas <%= icon %> w-5" aria-hidden="true"></i><span><%= label %></span></a>
            <% }); %>
            <hr class="my-4 border-admin-700">
            <a href="/" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-admin-700"><i class="fas fa-home w-5"></i><span>Public Site</span></a>
            <a href="/auth/logout" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-red-600 text-red-300"><i class="fas fa-sign-out-alt w-5"></i><span>Logout</span></a>
        </nav>
        <% const accountEmail = typeof user !== 'undefined' && user.email ? user.email : 'Admin'; %>
        <div class="admin-account bg-admin-900 border-t border-admin-700">
            <img src="/images/default-avatar.png" alt="" class="admin-account-avatar">
            <div class="admin-account-details">
                <p class="admin-account-email" title="<%= accountEmail %>"><%= accountEmail %></p>
                <p class="text-xs text-admin-300">Administrator</p>
            </div>
        </div>
    </div>
</aside>
<button id="sidebar-backdrop" type="button" aria-label="Tutup menu" hidden></button>
