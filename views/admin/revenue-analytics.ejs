<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Revenue Analytics - Sky Agency</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⭐</text></svg>">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        admin: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            200: '#bfdbfe',
                            300: '#93c5fd',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
    <script src="/vendor/chartjs/chart.umd.js"></script>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-navigation.css">
    <script src="/js/admin-navigation.js" defer></script>
    <script src="/vendor/jspdf/jspdf.umd.min.js" defer></script>
    <script src="/vendor/jspdf-autotable/jspdf.plugin.autotable.min.js" defer></script>
    <script src="/js/pdf-reports.js" defer></script>
</head>
<body class="bg-gray-50">

    
    <div class="flex h-screen bg-gray-100">
        <!-- Sidebar -->
        <%- include('../partials/admin-sidebar', { activePage: 'analytics' }) %>
        
        <!-- Main Content -->
        <div class="flex-1 min-w-0 flex flex-col overflow-hidden">
            <!-- Top Bar -->
            <header class="bg-white shadow-sm h-16 flex items-center justify-between px-6">
                <button id="open-sidebar" class="md:hidden text-gray-600 hover:text-gray-900">
                    <i class="fas fa-bars text-2xl"></i>
                </button>
                
                <h1 class="text-xl font-semibold text-gray-800">Revenue Analytics</h1>
                
                <div class="flex items-center space-x-4">
                    <a href="/auth/logout" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition">
                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                    </a>
                </div>
            </header>
            
            <!-- Page Content -->
            <main class="flex-1 overflow-y-auto p-6">
<div class="space-y-6">
    <!-- Header -->
    <div>
        <h2 class="text-2xl font-bold text-gray-800">Revenue Analytics</h2>
        <p class="text-gray-600 text-sm mt-1">Comprehensive revenue analysis and trends</p>
    </div>
    
    <!-- Date Range Selector -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between space-y-4 md:space-y-0">
            <div class="flex items-center space-x-4">
                <label class="text-sm font-medium text-gray-700">Date Range:</label>
                <input type="date" 
                       id="startDate" 
                       value="<%= typeof selectedStartDate !== 'undefined' ? selectedStartDate : '' %>"
                       class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-admin-500"
                       onchange="applyDateFilter()">
                <span class="text-gray-500">to</span>
                <input type="date" 
                       id="endDate" 
                       value="<%= typeof selectedEndDate !== 'undefined' ? selectedEndDate : '' %>"
                       class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-admin-500"
                       onchange="applyDateFilter()">
            </div>
            
            <div class="flex space-x-2">
                <button onclick="setDateRange('week')" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 text-sm">
                    This Week
                </button>
                <button onclick="setDateRange('month')" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 text-sm">
                    This Month
                </button>
                <button onclick="setDateRange('year')" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 text-sm">
                    This Year
                </button>
                <button onclick="exportAnalyticsPdf()" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 text-sm">
                    <i class="fas fa-file-pdf mr-2"></i>Export PDF
                </button>
            </div>
        </div>
    </div>
    
    <!-- Summary Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-gradient-to-br from-green-500 to-green-600 rounded-xl shadow-md p-6 text-white">
            <div class="flex items-center justify-between mb-2">
                <p class="text-green-100 text-sm font-medium">Uang Masuk</p>
                <i class="fas fa-chart-line text-2xl text-green-100"></i>
            </div>
            <p class="text-3xl font-bold"><%= typeof analytics !== 'undefined' ? formatCurrency(analytics.totalRevenue) : formatCurrency(0) %></p>
            <p class="text-green-100 text-sm mt-2">
                <i class="fas fa-arrow-up mr-1"></i>
                Berdasarkan tanggal pembayaran
            </p>
        </div>
        
        <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl shadow-md p-6 text-white">
            <div class="flex items-center justify-between mb-2">
                <p class="text-blue-100 text-sm font-medium">Rata-rata Pembayaran</p>
                <i class="fas fa-calculator text-2xl text-blue-100"></i>
            </div>
            <p class="text-3xl font-bold"><%= typeof analytics !== 'undefined' ? formatCurrency(analytics.avgTransaction) : formatCurrency(0) %></p>
            <p class="text-blue-100 text-sm mt-2">
                <%= typeof analytics !== 'undefined' ? analytics.receiptCount || 0 : 0 %> pembayaran tercatat
            </p>
        </div>
        
        <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl shadow-md p-6 text-white">
            <div class="flex items-center justify-between mb-2">
                <p class="text-purple-100 text-sm font-medium">Fee Agen Transaksi</p>
                <i class="fas fa-percentage text-2xl text-purple-100"></i>
            </div>
            <p class="text-3xl font-bold"><%= typeof analytics !== 'undefined' ? formatCurrency(analytics.totalCommission) : formatCurrency(0) %></p>
            <p class="text-purple-100 text-sm mt-2">
                From all transactions
            </p>
        </div>
        
        <div class="bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-xl shadow-md p-6 text-white">
            <div class="flex items-center justify-between mb-2">
                <p class="text-yellow-100 text-sm font-medium">Top Model Earnings</p>
                <i class="fas fa-star text-2xl text-yellow-100"></i>
            </div>
            <p class="text-3xl font-bold"><%= typeof analytics !== 'undefined' ? formatCurrency(analytics.topModelEarnings) : formatCurrency(0) %></p>
            <p class="text-yellow-100 text-sm mt-2">
                <%= typeof analytics !== 'undefined' ? analytics.topModelName : 'N/A' %>
            </p>
        </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white rounded-xl shadow-md p-5"><p class="text-gray-500 text-sm">Tagihan Client (periode transaksi)</p><p class="text-2xl font-bold"><%= formatCurrency(typeof analytics !== 'undefined' ? analytics.totalInvoiced || 0 : 0) %></p></div>
        <div class="bg-white rounded-xl shadow-md p-5"><p class="text-gray-500 text-sm">Sisa Tagihan (transaksi periode ini)</p><p class="text-2xl font-bold text-orange-700"><%= formatCurrency(typeof analytics !== 'undefined' ? analytics.outstanding || 0 : 0) %></p></div>
    </div>
    <p class="text-xs text-gray-500">Uang masuk memakai tanggal pembayaran; tagihan dan pendapatan model memakai tanggal transaksi.</p>
    <!-- Charts -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Tren Uang Masuk Chart -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">
                <i class="fas fa-chart-area mr-2 text-admin-500"></i>
                Tren Uang Masuk
            </h3>
            <div class="relative h-80 w-full"><canvas id="revenueTrendChart" class="h-full w-full"></canvas></div>
        </div>
        
        <!-- Job Types Distribution -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">
                <i class="fas fa-chart-pie mr-2 text-admin-500"></i>
                Revenue by Job Type
            </h3>
            <div class="relative h-80 w-full"><canvas id="jobTypesChart" class="h-full w-full"></canvas></div>
        </div>
        
        <!-- Top Models -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">
                <i class="fas fa-trophy mr-2 text-admin-500"></i>
                Top Earning Models
            </h3>
            <div class="relative h-80 w-full"><canvas id="topModelsChart" class="h-full w-full"></canvas></div>
        </div>
        
        <!-- Monthly Comparison -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">
                <i class="fas fa-chart-bar mr-2 text-admin-500"></i>
                Monthly Comparison
            </h3>
            <div class="relative h-80 w-full"><canvas id="monthlyComparisonChart" class="h-full w-full"></canvas></div>
        </div>
    </div>
    
    <!-- Detailed Stats Table -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">
            <i class="fas fa-table mr-2 text-admin-500"></i>
            Model Performance Summary
        </h3>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Model</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Jobs Completed</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Total Earnings</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Avg/Job</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Commission</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% if (typeof modelStats !== 'undefined' && modelStats.length > 0) { %>
                        <% modelStats.forEach(stat => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <img src="<%= stat.photo || '/images/default-avatar.png' %>" 
                                             alt="<%= stat.name %>" 
                                             class="w-8 h-8 rounded-full object-cover mr-3">
                                        <span class="text-sm font-medium text-gray-900"><%= stat.name %></span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    <%= stat.jobsCompleted %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">
                                    <%= formatCurrency(stat.totalEarnings) %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    <%= formatCurrency(stat.avgPerJob) %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    <%= formatCurrency(stat.commission) %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-gray-500">No data available</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    const chartData = <%- typeof chartData !== 'undefined' ? JSON.stringify(chartData) : '{}' %>;
    const analyticsSummary = <%- typeof analytics !== 'undefined' ? JSON.stringify(analytics) : '{}' %>;
    const modelStatsData = <%- typeof modelStats !== 'undefined' ? JSON.stringify(modelStats) : '[]' %>;
    
    // Tren Uang Masuk Chart
    new Chart(document.getElementById('revenueTrendChart'), {
        type: 'line',
        data: {
            labels: chartData.revenueLabels || [],
            datasets: [{
                label: 'Uang Masuk',
                data: chartData.revenueData || [],
                borderColor: 'rgb(59, 130, 246)',
                backgroundColor: 'rgba(59, 130, 246, 0.1)',
                tension: 0.4,
                fill: true
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });
    
    // Job Types Chart
    new Chart(document.getElementById('jobTypesChart'), {
        type: 'doughnut',
        data: {
            labels: chartData.jobTypeLabels || [],
            datasets: [{
                data: chartData.jobTypeData || [],
                backgroundColor: ['#ef4444', '#f59e0b', '#10b981', '#3b82f6', '#8b5cf6', '#ec4899']
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });
    
    // Top Models Chart
    new Chart(document.getElementById('topModelsChart'), {
        type: 'bar',
        data: {
            labels: chartData.topModelsLabels || [],
            datasets: [{
                label: 'Earnings',
                data: chartData.topModelsData || [],
                backgroundColor: 'rgba(168, 85, 247, 0.8)'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            indexAxis: 'y'
        }
    });
    
    // Monthly Comparison Chart
    new Chart(document.getElementById('monthlyComparisonChart'), {
        type: 'bar',
        data: {
            labels: chartData.monthlyLabels || [],
            datasets: [{
                label: 'This Year',
                data: chartData.thisYearData || [],
                backgroundColor: 'rgba(59, 130, 246, 0.8)'
            }, {
                label: 'Last Year',
                data: chartData.lastYearData || [],
                backgroundColor: 'rgba(156, 163, 175, 0.8)'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });
    
    function toDateInputValue(date) {
        return date.toISOString().slice(0, 10);
    }

    function applyDateFilter() {
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;
        const params = new URLSearchParams();
        if (startDate) params.set('start_date', startDate);
        if (endDate) params.set('end_date', endDate);
        window.location.href = `/admin/analytics${params.toString() ? `?${params.toString()}` : ''}`;
    }

    function setDateRange(period) {
        const now = new Date();
        const end = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const start = new Date(end);
        if (period === 'week') {
            start.setDate(end.getDate() - 6);
        } else if (period === 'month') {
            start.setDate(1);
        } else if (period === 'year') {
            start.setMonth(0, 1);
        }
        document.getElementById('startDate').value = toDateInputValue(start);
        document.getElementById('endDate').value = toDateInputValue(end);
        applyDateFilter();
    }

    function exportAnalyticsPdf() {
        const pdf = SkyPdf;
        const from = document.getElementById('startDate').value;
        const to = document.getElementById('endDate').value;
        let charts;
        try {
            charts = pdf.chartImages([
                { title: 'Tren Uang Masuk', type: 'line', data: { labels: chartData.revenueLabels || [], datasets: [{ label: 'Uang Masuk', data: chartData.revenueData || [], borderColor: '#2563EB', backgroundColor: '#DBEAFE', fill: true, tension: 0.3 }] } },
                { title: 'Uang Masuk per Grade', type: 'doughnut', data: { labels: chartData.jobTypeLabels || [], datasets: [{ data: chartData.jobTypeData || [], backgroundColor: ['#2563EB', '#C59B52', '#16A34A', '#7C3AED', '#F97316', '#64748B'] }] } },
                { title: 'Top Models', type: 'bar', horizontal: true, data: { labels: chartData.topModelsLabels || [], datasets: [{ label: 'Earnings', data: chartData.topModelsData || [], backgroundColor: '#7C3AED' }] } },
                { title: 'Monthly Comparison', type: 'bar', data: { labels: chartData.monthlyLabels || [], datasets: [{ label: 'This Year', data: chartData.thisYearData || [], backgroundColor: '#2563EB' }, { label: 'Last Year', data: chartData.lastYearData || [], backgroundColor: '#94A3B8' }] } }
            ]);
        } catch (error) {
            return showToast(error.message || 'Grafik PDF gagal dibuat.', 'error');
        }
        pdf.download({
            prefix: 'ANL', title: 'Revenue Analytics Report', charts,
            context: `Period: ${from ? pdf.date(from) : 'All dates'} - ${to ? pdf.date(to) : 'All dates'}`,
            metrics: [['Uang Masuk', pdf.money(analyticsSummary.totalRevenue)], ['Rata-rata Bayar', pdf.money(analyticsSummary.avgTransaction)], ['Fee Agen', pdf.money(analyticsSummary.totalCommission)], ['Top Model', analyticsSummary.topModelName || 'N/A'], ['Tagihan Client', pdf.money(analyticsSummary.totalInvoiced)], ['Sisa Tagihan', pdf.money(analyticsSummary.outstanding)]],
            sections: [{
                title: 'Model Performance',
                columns: ['#', 'Model', 'Jobs', 'Total Earnings', 'Avg / Job', 'Commission'], numeric: [2, 3, 4, 5],
                rows: modelStatsData.map((row, index) => [index + 1, row.name || '-', row.jobsCompleted || 0, pdf.money(row.totalEarnings), pdf.money(row.avgPerJob), pdf.money(row.commission)])
            }],
            signatures: ['Prepared By', 'Finance Approval', 'Management']
        });
    }

    function formatCurrencySafe(value) {
        return 'Rp ' + Number(value || 0).toLocaleString('id-ID');
    }
</script>
            </main>
        </div>
    </div>
    
    <!-- Sidebar Toggle Script -->

    
    <%- include('../partials/footer') %>
