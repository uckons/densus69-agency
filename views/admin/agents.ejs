<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agents Management - Sky Agency</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⭐</text></svg>">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        admin: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            200: '#bfdbfe',
                            300: '#93c5fd',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-navigation.css">
    <script src="/js/admin-navigation.js" defer></script>
</head>
<body class="bg-gray-50">

    
    <div class="flex h-screen bg-gray-100">
        <!-- Sidebar -->
        <%- include('../partials/admin-sidebar', { activePage: 'agents' }) %>
        
        <!-- Main Content -->
<div class="flex-1 min-w-0 flex flex-col overflow-hidden">
    <header class="bg-white shadow-sm h-16 shrink-0 flex items-center gap-4 px-6">
        <button id="open-sidebar" type="button" class="md:hidden text-gray-600 hover:text-gray-900" aria-label="Buka menu" aria-controls="sidebar" aria-expanded="false"><i class="fas fa-bars text-2xl" aria-hidden="true"></i></button>
        <h1 class="text-xl font-semibold text-gray-800">Agents Management</h1>
    </header>
<main class="flex-1 overflow-y-auto p-6">
    <div class="flex justify-between items-center mb-4">
        <h1 class="text-2xl font-bold">Agents Management</h1>
        <button id="addAgentBtn" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700">
            <i class="fas fa-plus mr-2"></i>Add Agent
        </button>
    </div>
    <div class="bg-white rounded-lg shadow-sm overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-2 text-left font-semibold">ID</th>
                    <th class="px-4 py-2 text-left font-semibold">Name</th>
                    <th class="px-4 py-2 text-left font-semibold">Email</th>
                    <th class="px-4 py-2 text-left font-semibold">Phone</th>
                    <th class="px-4 py-2 text-left font-semibold">Models Binaan</th>
                    <th class="px-4 py-2 text-left font-semibold">Uang Masuk</th>
                    <th class="px-4 py-2 text-left font-semibold">Fee Agent</th>
                    <th class="px-4 py-2 text-left font-semibold">Fee Model</th>
                    <th class="px-4 py-2 text-left font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody id="agentsTable" class="bg-white divide-y divide-gray-200"></tbody>
        </table>
    </div>
</main>
</div>
</div>

<!-- Modal Agent -->
<div id="agentModal" class="hidden fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-lg w-full max-w-md p-6 space-y-6">
        <h2 id="agentModalTitle" class="text-2xl font-bold mb-2">Add/Edit Agent</h2>
        
        <!-- WRAP WITH FORM -->
        <form id="agentForm" onsubmit="return false;">
            <input type="hidden" id="agentId">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Name</label>
                    <input id="agentName" type="text" class="mt-1 w-full px-3 py-2 border rounded focus:ring-green-600" autocomplete="name">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Email</label>
                    <input id="agentEmail" type="email" class="mt-1 w-full px-3 py-2 border rounded focus:ring-green-600" autocomplete="email">
                </div>
                <div id="passwordField">
                    <label class="block text-sm font-medium text-gray-700">Password <span class="text-red-500">*</span></label>
                    <input id="agentPassword" type="password" class="mt-1 w-full px-3 py-2 border rounded focus:ring-green-600" placeholder="Minimum 6 characters" autocomplete="new-password">
                    <p class="text-xs text-gray-500 mt-1">Required for new agent</p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Phone</label>
                    <input id="agentPhone" type="text" class="mt-1 w-full px-3 py-2 border rounded focus:ring-green-600" autocomplete="tel">
                </div>
            </div>
        </form>
        <!-- END FORM -->
        
        <div class="flex justify-end space-x-2 pt-2">
            <button id="agentModalAction" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-800">Save</button>
            <button id="closeAgentModal" class="px-4 py-2 border border-gray-300 rounded hover:bg-gray-100">Cancel</button>
        </div>
    </div>
</div>
<script src="/js/admin-agents.js"></script>
    
    <%- include('../partials/footer') %>
