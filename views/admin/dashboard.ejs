<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Sky Agency</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⭐</text></svg>">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        admin: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            200: '#bfdbfe',
                            300: '#93c5fd',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-navigation.css">
    <script src="/js/admin-navigation.js" defer></script>
</head>
<body class="bg-gray-50">

    
    <div class="flex h-screen bg-gray-100">
        <!-- Modern Sidebar -->
        <%- include('../partials/admin-sidebar', { activePage: 'dashboard' }) %>
        
        <!-- Main Content Wrapper -->
        <div class="flex-1 min-w-0 flex flex-col overflow-hidden">
            <!-- Top Bar -->
            <header class="bg-white shadow-sm h-16 flex items-center justify-between px-6">
                <button id="open-sidebar" class="md:hidden text-gray-600 hover:text-gray-900">
                    <i class="fas fa-bars text-2xl"></i>
                </button>
                
                <h1 class="text-xl font-semibold text-gray-800">Admin Dashboard</h1>
                
                <div class="flex items-center space-x-4">
                    <a href="/auth/logout" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition">
                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                    </a>
                </div>
            </header>
            
            <!-- Page Content -->
            <main class="flex-1 overflow-y-auto p-6">
            
            <!-- Welcome Banner -->
                <div class="bg-gradient-to-r from-admin-500 to-admin-700 rounded-xl shadow-lg p-8 text-white mb-8">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-3xl font-bold mb-2">Admin Dashboard</h2>
                            <p class="text-admin-100">Manage your agency platform</p>
                        </div>
                        <div class="hidden md:block">
                            <i class="fas fa-shield-alt text-6xl text-admin-300 opacity-50"></i>
                        </div>
                    </div>
                </div>
                
                <!-- Stats Cards Row 1 -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                    <!-- Total Models -->
                    <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-purple-500">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm font-medium">Total Models</p>
                                <p class="text-3xl font-bold text-gray-800 mt-2">
                                    <%= typeof stats !== 'undefined' ? stats.totalModels : 0 %>
                                </p>
                            </div>
                            <div class="bg-purple-100 p-4 rounded-full">
                                <i class="fas fa-users text-purple-600 text-2xl"></i>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Total Jobs -->
                    <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-blue-500">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm font-medium">Total Jobs</p>
                                <p class="text-3xl font-bold text-gray-800 mt-2">
                                    <%= typeof stats !== 'undefined' ? stats.totalJobs : 0 %>
                                </p>
                            </div>
                            <div class="bg-blue-100 p-4 rounded-full">
                                <i class="fas fa-briefcase text-blue-600 text-2xl"></i>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Active Jobs -->
                    <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-green-500">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm font-medium">Active Jobs</p>
                                <p class="text-3xl font-bold text-gray-800 mt-2">
                                    <%= typeof stats !== 'undefined' ? stats.activeJobs : 0 %>
                                </p>
                            </div>
                            <div class="bg-green-100 p-4 rounded-full">
                                <i class="fas fa-check-circle text-green-600 text-2xl"></i>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Pending Bookings -->
                    <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-yellow-500">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm font-medium">Pending Bookings</p>
                                <p class="text-3xl font-bold text-gray-800 mt-2">
                                    <%= typeof stats !== 'undefined' ? stats.pendingBookings : 0 %>
                                </p>
                            </div>
                            <div class="bg-yellow-100 p-4 rounded-full">
                                <i class="fas fa-clock text-yellow-600 text-2xl"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Revenue Stats Row 2 -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                    <!-- Total Revenue -->
                    <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-emerald-500">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm font-medium">Uang Masuk</p>
                                <p class="text-3xl font-bold text-gray-800 mt-2">
                                    <%= typeof stats !== 'undefined' ? formatCurrency(stats.totalRevenue) : formatCurrency(0) %>
                                </p>
                            </div>
                            <div class="bg-emerald-100 p-4 rounded-full">
                                <i class="fas fa-dollar-sign text-emerald-600 text-2xl"></i>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Monthly Revenue -->
                    <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-cyan-500">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm font-medium">This Month</p>
                                <p class="text-3xl font-bold text-gray-800 mt-2">
                                    <%= typeof stats !== 'undefined' ? formatCurrency(stats.monthlyRevenue) : formatCurrency(0) %>
                                </p>
                            </div>
                            <div class="bg-cyan-100 p-4 rounded-full">
                                <i class="fas fa-calendar text-cyan-600 text-2xl"></i>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Total Transactions -->
                    <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-indigo-500">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm font-medium">Total Transactions</p>
                                <p class="text-3xl font-bold text-gray-800 mt-2">
                                    <%= typeof stats !== 'undefined' ? stats.totalTransactions : 0 %>
                                </p>
                            </div>
                            <div class="bg-indigo-100 p-4 rounded-full">
                                <i class="fas fa-receipt text-indigo-600 text-2xl"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Charts -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <div class="bg-white rounded-xl shadow-md p-5"><p class="text-gray-500 text-sm">Total Tagihan Client</p><p class="text-2xl font-bold"><%= formatCurrency(typeof stats !== 'undefined' ? stats.totalInvoiced || 0 : 0) %></p></div>
                <div class="bg-white rounded-xl shadow-md p-5"><p class="text-gray-500 text-sm">Sisa Tagihan Belum Dibayar</p><p class="text-2xl font-bold text-orange-700"><%= formatCurrency(typeof stats !== 'undefined' ? stats.outstanding || 0 : 0) %></p></div>
            </div>
            <p class="text-xs text-gray-500 mb-4">Uang masuk berdasarkan pembayaran tercatat, bukan nilai gross transaksi. Catat pembayaran melalui menu Transactions → Bayar.</p>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                    <!-- Monthly Revenue Chart -->
                    <div class="bg-white rounded-xl shadow-md p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">
                            <i class="fas fa-chart-line text-admin-600 mr-2"></i>
                            Tren Uang Masuk Bulanan
                        </h3>
                        <div class="h-64">
                            <canvas id="revenueChart"></canvas>
                        </div>
                    </div>
                    
                    <!-- Stats Overview -->
                    <div class="bg-white rounded-xl shadow-md p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">
                            <i class="fas fa-chart-pie text-admin-600 mr-2"></i>
                            Platform Overview
                        </h3>
                        <div class="h-64">
                            <canvas id="overviewChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Recent Transactions -->
                <div class="bg-white rounded-xl shadow-md p-6 mb-8">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4">
                        <i class="fas fa-money-bill-wave text-admin-600 mr-2"></i>
                        Recent Transactions
                    </h3>
                    <% if (typeof recentTransactions !== 'undefined' && recentTransactions.length > 0) { %>
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Model</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Client</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200">
                                    <% recentTransactions.forEach(tx => { %>
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-6 py-4 text-sm">#<%= tx.id %></td>
                                            <td class="px-6 py-4"><%= tx.model_name || 'N/A' %></td>
                                            <td class="px-6 py-4"><%= tx.client_name || 'N/A' %></td>
                                            <td class="px-6 py-4 font-semibold text-green-600"><%= formatCurrency(tx.gross_amount) %></td>
                                            <td class="px-6 py-4 text-sm"><%= new Date(tx.transaction_date).toLocaleDateString('id-ID') %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <p class="text-gray-500 text-center py-8">No transactions yet</p>
                    <% } %>
                </div>

                <!-- Recent Models -->
                <div class="bg-white rounded-xl shadow-md p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4">
                        <i class="fas fa-users text-admin-600 mr-2"></i>
                        Recently Registered Models
                    </h3>
                    <% if (typeof recentModels !== 'undefined' && recentModels.length > 0) { %>
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Height</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Registered</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200">
                                    <% recentModels.forEach(model => { %>
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-6 py-4"><%= model.full_name %></td>
                                            <td class="px-6 py-4 text-sm"><%= model.email %></td>
                                            <td class="px-6 py-4"><%= model.height %> cm</td>
                                            <td class="px-6 py-4 text-sm"><%= new Date(model.created_at).toLocaleDateString('id-ID') %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <p class="text-gray-500 text-center py-8">No models yet</p>
                    <% } %>
                </div>

            </main>
        </div>
    </div>
    
    <!-- Sidebar Toggle Script -->

    
    <script>
        // Revenue Chart
        const revenueCtx = document.getElementById('revenueChart');
        if (revenueCtx) {
            const monthlyChartRows = <%- JSON.stringify(typeof monthlyChartData !== 'undefined' ? monthlyChartData : []) %>;
            const revenueMap = new Map(monthlyChartRows.map((row) => [row.year_month, Number(row.revenue || 0)]));

            const labels = [];
            const values = [];
            const now = new Date();
            for (let i = 11; i >= 0; i -= 1) {
                const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
                const yearMonth = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
                labels.push(d.toLocaleString('en-US', { month: 'short' }));
                values.push(Number(revenueMap.get(yearMonth) || 0));
            }

            new Chart(revenueCtx.getContext('2d'), {
                type: 'line',
                data: {
                    labels,
                    datasets: [{
                        label: 'Uang Masuk',
                        data: values,
                        borderColor: 'rgb(59, 130, 246)',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'Rp ' + Number(value || 0).toLocaleString('id-ID');
                                }
                            }
                        }
                    }
                }
            });
        }
        
        // Overview Chart
        const overviewCtx = document.getElementById('overviewChart');
        if (overviewCtx) {
            new Chart(overviewCtx.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: ['Models', 'Active Jobs', 'Pending Bookings', 'Completed Jobs'],
                    datasets: [{
                        data: [
                            <%= typeof stats !== 'undefined' ? stats.totalModels : 0 %>,
                            <%= typeof stats !== 'undefined' ? stats.activeJobs : 0 %>,
                            <%= typeof stats !== 'undefined' ? stats.pendingBookings : 0 %>,
                            <%= typeof stats !== 'undefined' ? (stats.totalJobs - stats.activeJobs) : 0 %>
                        ],
                        backgroundColor: [
                            'rgb(168, 85, 247)',
                            'rgb(34, 197, 94)',
                            'rgb(251, 191, 36)',
                            'rgb(59, 130, 246)'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });
        }
    </script>

    <%- include('../partials/footer') %>
