            document.getElementById('transactionEditModal').classList.remove('hidden');
        } catch (error) {
            showToast(error.message || 'Terjadi kesalahan', 'error');
        }
    }

    async function submitEditTransaction() {
        const id = document.getElementById('editTransactionId').value;
        const payload = {
            client_name: document.getElementById('editClientName').value.trim(),
            transaction_date: document.getElementById('editTransactionDate').value,
            transaction_count: Number(document.getElementById('editTransactionCount').value || 0),
            fine: Number(document.getElementById('editFine').value || 0),
            cash_advance: Number(document.getElementById('editCashAdvance').value || 0),
            description: document.getElementById('editDescription').value.trim()
        };

        if (!payload.client_name || !payload.transaction_date || !Number.isInteger(payload.transaction_count) || payload.transaction_count < 1) {
            showToast('Client, tanggal, dan jumlah trx wajib diisi', 'error');
            return;
        }

        if (![payload.fine, payload.cash_advance].every(value => Number.isFinite(value) && value >= 0)) {
            showToast('Denda dan cash advance harus berupa angka nol atau lebih', 'error');
            return;
        }

        try {
            const response = await fetch(`/api/transactions/${id}`, {
                method: 'PUT',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await response.json();

            if (!response.ok || !data.success) {
                const msg = data.message || (Array.isArray(data.errors) && data.errors[0]?.msg) || 'Gagal update transaksi';
                throw new Error(msg);
            }

            closeEditTransactionModal();
            showToast('Transaction berhasil diupdate', 'success');
            setTimeout(() => window.location.reload(), 700);
        } catch (error) {
            showToast(error.message || 'Terjadi kesalahan', 'error');
        }
    }

    async function deleteTransaction(id) {
        if (!confirm('Are you sure you want to delete this transaction?')) return;

        try {
            showLoading();
            const response = await fetch(`/api/transactions/${id}`, {
                method: 'DELETE',
                credentials: 'include'
            });

            const data = await response.json();
            hideLoading();

            if (data.success) {
                showToast('Transaction deleted', 'success');
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showToast(data.message || 'Failed to delete', 'error');
            }
        } catch (error) {
            hideLoading();
            showToast('An error occurred', 'error');
        }
    }


    function exportClientInvoice() {
        const rows = filteredTransactions;
        if (!rows.length) return showToast('Tidak ada transaksi untuk dibuat invoice', 'error');
        const pdf = SkyPdf;
        const clients = new Map();
        rows.forEach(tx => {
            const name = tx.client_name || 'N/A';
            if (!clients.has(name)) clients.set(name, []);
            clients.get(name).push(tx);
        });
        pdf.download({
            prefix: 'INV', title: 'Client Invoice Summary', confidential: false,
            context: getPdfFilterContext(),
            metrics: [['Invoice Total', pdf.money(pdf.sum(rows, 'gross_amount'))], ['Clients', clients.size], ['Records', rows.length]],
            sections: Array.from(clients, ([client, records]) => ({
                title: 'Bill To: ' + client,
                columns: ['#', 'Date', 'Model / Grade', 'TRX', 'Rate', 'Amount'], numeric: [3, 4, 5],
                rows: records.map((tx, index) => [index + 1, pdf.date(tx.transaction_date), (tx.model_name || '-') + '\n' + (tx.model_grade_name || '-'), tx.transaction_count || 0, pdf.money(tx.model_rate), pdf.money(tx.gross_amount)]),
                totals: ['CLIENT TOTAL', '', '', pdf.sum(records, 'transaction_count'), '', pdf.money(pdf.sum(records, 'gross_amount'))]
            })),
            note: 'Amounts follow the selected transaction records. This document does not confirm payment.',
            signatures: ['Finance', 'Client Approval']
        });
    }

    function getPdfFilterContext() {
        const model = document.getElementById('modelFilter');
        const status = document.getElementById('statusFilter');
        const from = document.getElementById('fromDate').value;
        const to = document.getElementById('toDate').value;
        return `Period: ${from ? SkyPdf.date(from) : 'All dates'} - ${to ? SkyPdf.date(to) : 'All dates'}  |  Model: ${model.selectedOptions[0]?.textContent || 'All Models'}  |  Status: ${status.selectedOptions[0]?.textContent || 'All Status'}`;
    }

    function exportTransactions() {
        const rows = filteredTransactions;
        if (!rows.length) return showToast('Tidak ada transaksi untuk diexport', 'error');
        const pdf = SkyPdf;
        const agentTotal = rows.reduce((total, tx) => total + getAgentFeeAmount(tx), 0);
        pdf.download({
            prefix: 'TXR', title: 'Transaction & Payroll Report', landscape: true,
            context: getPdfFilterContext(),
            metrics: [['Records', rows.length], ['Gross Revenue', pdf.money(pdf.sum(rows, 'gross_amount'))], ['Potongan Non-Agen', pdf.money(rows.reduce((sum, tx) => sum + getNonAgentDeductions(tx), 0))], ['Agent Fee', pdf.money(agentTotal)], ['Net Model Payout', pdf.money(pdf.sum(rows, 'net_amount'))]],
            sections: [{
                title: 'Transaction Register',
                columns: ['#', 'Date', 'Model / Grade', 'Client', 'TRX', 'Gross', 'Potongan Non-Agen', 'Agent Fee', 'Net Payout'], numeric: [4, 5, 6, 7, 8],
                rows: rows.map((tx, index) => [index + 1, pdf.date(tx.transaction_date), (tx.model_name || '-') + '\n' + (tx.model_grade_name || '-'), tx.client_name || '-', tx.transaction_count || 0, pdf.money(tx.gross_amount), pdf.money(getNonAgentDeductions(tx)), pdf.money(getAgentFeeAmount(tx)), pdf.money(tx.net_amount)]),
                totals: ['TOTAL', '', '', '', pdf.sum(rows, 'transaction_count'), pdf.money(pdf.sum(rows, 'gross_amount')), pdf.money(rows.reduce((sum, tx) => sum + getNonAgentDeductions(tx), 0)), pdf.money(agentTotal), pdf.money(pdf.sum(rows, 'net_amount'))]
            }],
            note: 'Gross - ((Safety + Admin Fee Client) x TRX) - Lain-lain - Denda - Cash Advance - Agent Fee = Net Model Payout. All records matching the active filters are included, across all table pages.',
            signatures: ['Prepared By', 'Finance Approval', 'Management']
        });
    }

    async function loadClientKpis() {
        try {
            const response = await fetch('/api/transactions/client-kpis', { credentials: 'include' });
            const data = await response.json();
            if (!response.ok || !data.success) return;

            document.getElementById('kpi-total-clients').textContent = Number(data.data?.total_clients || 0).toLocaleString('id-ID');
            const topClient = data.data?.top_client;
            document.getElementById('kpi-top-client').textContent = topClient?.client_name || '-';
            document.getElementById('kpi-top-client-revenue').textContent = 'Rp ' + Number(topClient?.total_revenue || 0).toLocaleString('id-ID');
        } catch (_) {}
    }

    document.getElementById('editTransactionForm').addEventListener('input', updateEditPayrollPreview);
    document.addEventListener('DOMContentLoaded', () => {
        populateModelFilter();
        applyFilters();
    });
</script>
            </main>
        </div>
    </div>

