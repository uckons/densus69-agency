        document.getElementById('editPayrollPreview').textContent = changed && !client ? 'Pilih client terdaftar.' :
            `Safety / TRX: ${formatCurrencySafe(data.safety_fee)} | Admin / TRX: ${formatCurrencySafe(data.client_admin_fee)} | Lain-lain: ${formatCurrencySafe(data.other_deduction)} | Agent Fee: ${formatCurrencySafe(totals.agent)} | Bersih: ${formatCurrencySafe(totals.net)}. Tarif tersimpan dipakai selama client tidak berubah.`;
