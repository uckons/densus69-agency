        const client = editClients.find(item => item.client_name.toLowerCase() === name.toLowerCase());
        const data = { ...tx, model_rate: Number(tx.model_rate),
            safety_fee: changed ? client?.safety_fee || 0 : tx.safety_fee,
            client_admin_fee: changed ? client?.admin_fee || 0 : tx.client_admin_fee,
            other_deduction: changed ? client?.other_deduction || 0 : tx.other_deduction,
            transaction_count: document.getElementById('editTransactionCount').value,
            fine: document.getElementById('editFine').value, cash_advance: document.getElementById('editCashAdvance').value,
            agent_fee_per_trx: tx.agent_fee_per_trx ?? (getAgentFeeAmount(tx) / Number(tx.transaction_count))
        };
