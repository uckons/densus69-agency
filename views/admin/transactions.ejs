    async function openEditTransaction(id) {
        try {
            const response = await fetch(`/api/transactions/${id}`, { credentials: 'include' });
            const data = await response.json();
            if (!response.ok || !data.success) {
                throw new Error(data.message || 'Gagal memuat data transaksi');
            }

            const tx = data.data?.transaction || {};
            const model = data.data?.model || {};
            document.getElementById('editTransactionId').value = tx.id || id;
            document.getElementById('editModelName').value = model.full_name || tx.model_name || '-';
            document.getElementById('editClientName').value = tx.client_name || '';
            document.getElementById('editTransactionDate').value = tx.transaction_date ? new Date(tx.transaction_date).toISOString().slice(0, 10) : '';
            document.getElementById('editTransactionCount').value = tx.transaction_count || 1;
            document.getElementById('editFine').value = Payroll.breakdown(tx).fine;
            document.getElementById('editCashAdvance').value = Number(tx.cash_advance || 0);
            editingTransaction = tx;
            try { const clientsResponse = await fetch('/api/admin/clients', {credentials:'include'}); const clientsData = await clientsResponse.json(); editClients = clientsData.success ? clientsData.data : []; } catch (_) { editClients = []; }
            const list = document.getElementById('editClientOptions'); list.replaceChildren();
            editClients.forEach(client => { const option = document.createElement('option'); option.value = client.client_name; list.appendChild(option); });
            updateEditPayrollPreview();
